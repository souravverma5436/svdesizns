import React, { useRef } from 'react';
import { Canvas, useFrame } from '@react-three/fiber';
import { OrbitControls, useTexture, Center, Environment, ContactShadows, Float } from '@react-three/drei';
import * as THREE from 'three';

const BusinessCard = () => {
  const cardRef = useRef();

  // Load textures for front and back
  const frontTexture = useTexture('/images/frontside.jpeg');
  const backTexture = useTexture('/images/backside.jpeg');

  // Animation: Very slow, elegant rotation
  useFrame((state) => {
    if (cardRef.current) {
      cardRef.current.rotation.y += 0.005;
    }
  });

  return (
    <Float speed={2} rotationIntensity={0.5} floatIntensity={0.5}>
      <Center>
        <mesh ref={cardRef} castShadow>
          <boxGeometry args={[5, 2.85, 0.1]} />

          {/* Side edges: Slightly off-white for a realistic card stock look */}
          <meshStandardMaterial attach="material-0" color="#f8f8f8" roughness={0.5} />
          <meshStandardMaterial attach="material-1" color="#f8f8f8" roughness={0.5} />
          <meshStandardMaterial attach="material-2" color="#f8f8f8" roughness={0.5} />
          <meshStandardMaterial attach="material-3" color="#f8f8f8" roughness={0.5} />

          {/* FRONT SIDE: High-end Glossy finish with Clearcoat */}
          <meshPhysicalMaterial
            attach="material-4"
            map={frontTexture}
            roughness={0.1}
            metalness={0.1}
            clearcoat={1.0}
            clearcoatRoughness={0.1}
            reflectivity={1}
          />

          {/* BACK SIDE: High-end Glossy finish with Clearcoat */}
          <meshPhysicalMaterial
            attach="material-5"
            map={backTexture}
            roughness={0.1}
            metalness={0.1}
            clearcoat={1.0}
            clearcoatRoughness={0.1}
            reflectivity={1}
          />
        </mesh>
      </Center>
    </Float>
  );
};

const BusinessCardViewer = () => {
  return (
    <div style={{ width: '100%', height: '600px', background: 'transparent' }}>
      <Canvas shadows camera={{ position: [0, 0, 7], fov: 40 }}>
        {/* Cinematic Lighting Setup */}
        <ambientLight intensity={0.7} />

        {/* Key Light: Primary bright light from the front-right */}
        <spotLight
          position={[5, 5, 5]}
          angle={0.3}
          penumbra={1}
          intensity={2}
          castShadow
          shadow-mapSize={[1024, 1024]}
        />

        {/* Fill Light: Soft light from the left to fill shadows */}
        <pointLight position={[-5, 2, 2]} intensity={0.8} color="#ffffff" />

        {/* Accent Lights: Subtle colors for design studio vibe */}
        <pointLight position={[-10, -5, -5]} intensity={0.6} color="#6366f1" />
        <pointLight position={[10, 5, -5]} intensity={0.6} color="#a855f7" />

        {/* Environment: 'studio' is more professional than 'city' for product shots */}
        <Environment preset="studio" />

        <BusinessCard />

        {/* High-quality shadow for grounding */}
        <ContactShadows
          position={[0, -2.2, 0]}
          opacity={0.5}
          scale={10}
          blur={2}
          far={4}
        />

        <OrbitControls
          enableZoom={false}
          enablePan={false}
          minPolarAngle={Math.PI / 3}
          maxPolarAngle={Math.PI / 1.5}
          enableDamping={true}
          dampingFactor={0.05}
        />
      </Canvas>
    </div>
  );
};

export default BusinessCardViewer;
